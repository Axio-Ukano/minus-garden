# Enforce LF line endings everywhere — prevents CRLF drift on Windows.
# The repo-local .git/config also sets core.autocrlf=false and core.eol=lf.
* text=auto eol=lf

# ── Source code ────────────────────────────────────────────────────────────────
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.rs text eol=lf
*.css text eol=lf
*.html text eol=lf

# ── Config / Data ──────────────────────────────────────────────────────────────
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.lock text eol=lf

# Dotfiles that lack an extension
.gitattributes text eol=lf
.gitignore text eol=lf
.prettierrc text eol=lf
.prettierignore text eol=lf
.eslintrc text eol=lf

# ── Binary — never touch ──────────────────────────────────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.ttf binary
*.woff binary
*.woff2 binary
