# ============================================================
# minu-garden — .gitignore
# Stack: Tauri 2 + Rust + React + TypeScript + Tailwind + SQLite
# ============================================================


# ───────────────────────────────────────────
# DEPENDENCIES
# ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz


# ───────────────────────────────────────────
# BUILD OUTPUT — FRONTEND
# ───────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo


# ───────────────────────────────────────────
# BUILD OUTPUT — RUST / TAURI
# ───────────────────────────────────────────
src-tauri/target/
src-tauri/gen/
*.exe
*.msi
*.app
*.dmg
*.deb
*.rpm
*.AppImage


# ───────────────────────────────────────────
# TAURI SPECIFIC
# ───────────────────────────────────────────
# Tauri build artifacts and generated files
src-tauri/WixTools/
src-tauri/Cargo.lock.bak

# Dev watcher ignore file (local only)
.taurignore


# ───────────────────────────────────────────
# RUST
# ───────────────────────────────────────────
# Keep Cargo.lock for binary crates (apps), not libraries
# For a Tauri app (binary), Cargo.lock SHOULD be committed
# Uncomment below only if this becomes a library crate:
# src-tauri/Cargo.lock

# Rust incremental compilation cache
src-tauri/target/


# ───────────────────────────────────────────
# DATABASE — SQLite
# ───────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Database backups
*.db.bak
*.db.backup


# ───────────────────────────────────────────
